{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "build": {
      "description": "Build, lint, and test the project",
      "prompt": "Run uv sync --dev, then verify with ruff check and pytest. Fix all issues.",
      "temperature": 0.2
    },
    "explore": {
      "description": "Explore the codebase to find relevant files and understand architecture",
      "prompt": "Use glob and grep to find files matching the user's query. Summarize the architecture and relevant patterns.",
      "temperature": 0.3
    }
  },
  "mcp": {
    "filesystem": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-filesystem", "C:\\Users\\Luke\\Documents\\GitHub\\replayPos"]
    },
    "github": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-github"],
      "environment": {
        "GITHUB_TOKEN": "${GITHUB_TOKEN}"
      }
    }
  },
  "instructions": ["AGENTS.md"]
}
